#!/bin/sh

set -eu

# Pinned because staticcheck cannot analyse this module's Go toolchain version
# below v0.8.1 -- older releases fail every package with an internal export-data
# error rather than reporting findings.
STATICCHECK_VERSION=v0.8.1

usage() {
	cat <<'EOF'
Usage: scripts/check <format|vet|lint|test|race|coverage|tidy|all>
EOF
}

# check_format asks Git which Go files the repository owns rather than walking
# the tree. A walk also reaches gitignored checkouts of this same repository --
# Symphony's own runtime workspaces under .symphony/workspaces and agent
# worktrees under .claude/worktrees -- and lints whatever a dispatched agent
# left mid-turn as if it were repository source. That makes this command fail on
# a clean checkout, for a file no one is editing and that CI, which starts from
# a fresh tree, never sees (PMR-89).
#
# The other stages need no equivalent: go vet and go test take ./..., which the
# Go tool already resolves against this module's own packages. A nested checkout
# carries its own go.mod, so it is not part of this module.
check_format() {
	if ! tracked=$(git ls-files -- '*.go' | wc -l); then
		printf 'scripts/check format needs a Git checkout to resolve repository source\n' >&2
		return 1
	fi
	# A silent pass because the file list came back empty would be worse than a
	# failure: it reports success without having checked anything.
	if [ "$tracked" -eq 0 ]; then
		printf 'no Go files are tracked in this checkout\n' >&2
		return 1
	fi
	unformatted=$(git ls-files -z -- '*.go' | xargs -0 gofmt -l)
	if [ -n "$unformatted" ]; then
		printf 'The following files need gofmt:\n%s\n' "$unformatted" >&2
		return 1
	fi
}

run_vet() {
	go vet ./...
}

# go run, not go install: go install writes to GOBIN outside this repository,
# which an agent sandbox does not grant write access to. go run only touches
# the module cache.
#
# GOTOOLCHAIN=auto is scoped to this one invocation and is load-bearing in CI.
# staticcheck v0.8.1 needs go >= 1.26 to *build itself*, while go.mod declares
# go 1.25.0 and actions/setup-go pins GOTOOLCHAIN=local, so the default would
# refuse to fetch a newer toolchain and fail before analysing anything:
#
#   honnef.co/go/tools@v0.8.1 requires go >= 1.26.0 (running go 1.25.0;
#   GOTOOLCHAIN=local)
#
# Setting it here rather than raising go.mod's directive keeps the module's
# declared minimum Go an independent decision: this only governs which
# toolchain builds the linter, never what Symphony itself requires.
run_lint() {
	GOTOOLCHAIN=auto go run "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}" ./...
}

run_tests() {
	go test -timeout 5m ./...
}

run_race_tests() {
	go test -race -timeout 8m ./...
}

# Prints per-package coverage and the 0%-covered function list. It does not
# gate on either: a hard threshold on a repo ranging 32%-98% coverage per
# package would either be trivially met or block everything today. Narrowing
# this to a ratchet is future work once the baseline has run for a while.
#
# internal/agenttest is left out of the 0%-covered list, and only that list. It
# is test support imported exclusively by other packages' tests, and Go measures
# coverage per package, so every function in it reports 0% however heavily the
# suites that import it exercise it. Listing all of them would add two dozen
# permanently unactionable lines to a report whose whole value is that every line
# on it is worth looking at.
run_coverage() {
	profile=$(mktemp -p "${TMPDIR:-/tmp}" symphony-coverage.XXXXXX)
	trap 'rm -f "$profile"' EXIT
	go test -timeout 5m -coverprofile="$profile" ./...
	func_report=$(go tool cover -func="$profile")
	printf '%s\n' "$func_report"
	zero=$(printf '%s\n' "$func_report" | awk '$1 != "total:" && $NF == "0.0%" && $1 !~ /\/internal\/agenttest\//')
	if [ -n "$zero" ]; then
		printf '\n0%%-covered functions:\n%s\n' "$zero"
	else
		printf '\nno 0%%-covered functions\n'
	fi
}

# go mod tidy -diff already exits non-zero and prints the pending diff on
# stdout when go.mod/go.sum are not tidy, so this needs no extra scripting.
run_tidy() {
	go mod tidy -diff
}

if [ "$#" -ne 1 ]; then
	usage >&2
	exit 2
fi

case "$1" in
	format)
		check_format
		;;
	vet)
		run_vet
		;;
	lint)
		run_lint
		;;
	test)
		run_tests
		;;
	race)
		run_race_tests
		;;
	coverage)
		run_coverage
		;;
	tidy)
		run_tidy
		;;
	all)
		check_format
		run_vet
		run_lint
		run_tests
		run_race_tests
		run_coverage
		run_tidy
		;;
	*)
		usage >&2
		exit 2
		;;
esac
